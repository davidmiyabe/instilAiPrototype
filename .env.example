# Anthropic API Configuration
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Database Configuration
DATABASE_URL=sqlite:///nonprofit_crm.db
# For PostgreSQL, use format: postgresql://user:password@localhost:5432/nonprofit_crm

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api

# Message Generator Configuration
DEFAULT_MESSAGE_LENGTH=200
MIN_MESSAGE_LENGTH=150
MAX_MESSAGE_LENGTH=500
DEFAULT_TONE=warm, human, relationship-forward
GENERATE_ALTERNATES=False
NUM_ALTERNATES=3

# Application Configuration
APP_NAME=Nonprofit CRM
DEBUG=False
